{
  "expo": {
    "name": "PushupCrew",
    "slug": "pushup-crew",
    "scheme": "pushupcrew",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050505",
    "icon": "./assets/splash.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#050505",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.pushupcrew.app",
      "supportsTablet": false,
      "userInterfaceStyle": "dark",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pushupcrew.app",
      "userInterfaceStyle": "dark",
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash.png",
        "backgroundColor": "#050505"
      },
      "splash": {
        "image": "./assets/splash.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "color": "#BFFF00",
          "defaultChannel": "daily-reminders",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PushupCrew uses your location to place your crew in your local area ranking."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "292727b2-8ad2-4a65-a59f-d46d6e774b61"
      }
    }
  }
}
