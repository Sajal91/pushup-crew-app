# Supabase (Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth is configured in Supabase Dashboard (Authentication → Providers → Google).
# Add redirect URLs under Authentication → URL Configuration, e.g.:
#   pushupcrew://auth/callback          (dev build / production)
#   exp://192.168.x.x:8081/--/auth/callback   (Expo Go — copy from Metro log)
# Tip: add a wildcard for local Expo Go: exp://**/--/auth/callback
